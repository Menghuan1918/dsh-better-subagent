{
  "name": "@menghuan1918/dsh-better-subagent",
  "version": "0.1.1",
  "description": "Standalone DSH plugin: Codex/Claude continuable CLI subagents, wait_subagent, child exit guard and model tiers. Pure ESM, no build step.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Menghuan1918/dsh-better-subagent.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/runtime-smoke.mjs"
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "third-party"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "subagent",
    "codex",
    "claude",
    "cli"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session-query": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-storage": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-storage-json": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
